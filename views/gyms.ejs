<!DOCTYPE html>
<html>
  <head>
    <!-- Page title with dynamic shop name -->
    <title>Gyms at <%= shopName %></title>
    <%- include('partials/styles') %>
  </head>

  <body>
    <!-- Navigation bar rendered accordingly -->
    <%- include('partials/nav') %>
    <header>
      <h1>Gyms</h1>
    </header>
    <main>
      <h2>Locations</h2>
      <!-- Change gyms to empty array if undefined -->
      <% gyms = gyms || []; %>
      <div>
        <!-- Search bar as a form -->
        <form method="GET" action="<%= basePath %>/gyms">
          <label for="searchlocations">Search Locations: </label>
          <input
            type="text"
            id="searchlocations"
            name="searchlocations"
            placeholder="e.g. London"
          />
          <div><button type="submit">Search</button></div>
        </form>
      </div>
      <div>
        <!-- Gym location listings with embedded map -->
        <% gyms.forEach(gym => { %>
        <h3><%= gym.city %></h3>
        <iframe
          src="<%= gym.map_embed %>"
          width="300"
          height="300"
          style="border: 0"
          allowfullscreen=""
          loading="lazy"
        ></iframe>
        <% }) %>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
