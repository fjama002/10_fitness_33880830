<!DOCTYPE html>
<html>
  <head>
    <!-- Page title with dynamic shop name -->
    <title>About <%= shopName %></title>
    <%- include('partials/styles') %>
  </head>

  <body>
    <!-- Navigation bar rendered accordingly -->
    <%- include('partials/nav') %>
    <header>
      <h1>About Us</h1>
    </header>
    <main>
      <h2>Founder</h2>
      <div class="aboutus">
        <!-- Image of founder -->
        <img
          src="https://static.vecteezy.com/system/resources/thumbnails/077/071/196/small/3d-cute-cartoon-faceless-male-avatar-bust-with-brown-hair-and-orange-jacket-isolated-on-transparent-background-png.png"
          alt="Picture of Founder"
        />
        <div>
          <!-- About message using dynamic shop name -->
          <p>
            <%= shopName %> is a family owned business, promoting physical and
            mental wellbeing. If you come by, we hope you enjoy the many
            services we offer! Find out more at:
            <a href="/classes"><%= shopName %> Classes</a>
          </p>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
