<!DOCTYPE html>
<html>
  <head>
    <!-- Page title with dynamic shop name -->
    <title>Welcome to <%= shopName %></title>
    <%- include('partials/styles') %>
  </head>

  <body>
    <!-- Navigation bar rendered accordingly -->
    <%- include('partials/nav') %>
    <header>
      <!-- If user authenticated, display: -->
      <% if (user) { %>
      <h1>Welcome <%= user.forename %> to <%= shopName %></h1>
      <!-- Else, display usual: -->
      <% } else { %>
      <h1>Welcome to <%= shopName %></h1>
      <% } %>
    </header>
    <main>
      <div>
        <!-- Mini introduction -->
        <h2>Our Aim</h2>
        <p>
          Here at <%= shopName %>, we aim to support you and your journey,
          helping you grow in confidence in yourself and your abilities!
        </p>
      </div>
      <div>
        <!-- Dynamic quotes to add some fun -->
        <h2>Quote of the Day</h2>
        <p><%= quote %></p>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
